# Репозиторий фронтенда. Публичный, поэтому здесь не только мусор сборки:
# всё, что содержит данные компании или доступы, исключено намеренно.

# ── Зависимости и сборка ──────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/.next/
/out/
/build
/coverage
*.tsbuildinfo
next-env.d.ts

# ── Доступы ───────────────────────────────────────────────────────────
# Адрес API и любые ключи задаются локально. Образец — в .env.example.
.env
.env.*
!.env.example
*.pem

# ── Данные компании ───────────────────────────────────────────────────
# Бэкенд живёт отдельно: в нём доступы к Shipox и Supabase.
/backend/
# Выгрузка базы Supabase: тысячи строк с клиентами и расчётами.
/backups/
# Файлы выгрузок заказов.
/exports/
*.csv
*.xlsx
*.zip
# Дампы базы.
*.sql
*.dump

# ── Локальное окружение ───────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Проверки браузером ────────────────────────────────────────────────
/playwright-report/
/test-results/

# ── Вертикаль развёртывания ───────────────────────────────────────────
.vercel
