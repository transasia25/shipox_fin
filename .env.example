# Куда фронт проксирует `/api`: адрес бэкенда. Браузер всегда ходит на свой
# origin, иначе кука сессии становится сторонней и Safari её не сохраняет.
API_ORIGIN=http://localhost:4000

# Адрес API бэкенда. Локально — NestJS из соседнего репозитория, по умолчанию
# http://localhost:4000/api. На сервере подставьте свой адрес.
NEXT_PUBLIC_API_URL=/api
